{
  "name": "yunbox-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "description": "兼容 Git LFS 的素材托管",
  "author": "YunYouJun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunLeFun/yunbox.git"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nr -r build",
    "dev": "nr -r --parallel dev",
    "docs:build": "pnpm --filter @yunbox/docs build",
    "docs:dev": "pnpm --filter @yunbox/docs dev",
    "icons:check": "node script/sync-app-icon.mjs --check",
    "icons:sync": "node script/sync-app-icon.mjs",
    "lint": "eslint --cache .",
    "release": "node script/changelog.mjs check --unreleased && bumpp",
    "release:notes": "node script/changelog.mjs github",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter @yunbox/docs typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@cloudbase/signature-nodejs": "catalog:",
    "@smithy/signature-v4": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "cos-nodejs-sdk-v5": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
