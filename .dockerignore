# Keep the build context small and free of local state and secrets.
**/node_modules
**/dist
**/coverage
**/*.log
.git
.github
.vscode
.idea
.claude
.cache
.eslintcache
.yunbox-data
.env
.env.*
*.tgz
docs/*
# The docs site is a workspace package; the frozen-lockfile install needs its manifest.
!docs/package.json
Dockerfile
.dockerignore
