{
  "name": "yunbox",
  "type": "module",
  "version": "0.1.9",
  "description": "云匣 YunBox 命令行：git-lfs 素材直传腾讯云 COS，不需要服务端",
  "author": "YunYouJun <me@yunyoujun.cn>",
  "license": "MIT",
  "homepage": "https://github.com/YunLeFun/yunbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunLeFun/yunbox.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/YunLeFun/yunbox/issues",
  "keywords": [
    "git-lfs",
    "lfs",
    "cos",
    "tencent-cloud",
    "game-assets",
    "yunbox"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "git-yunbox": "./dist/cli.mjs",
    "yunbox": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@yunbox/core": "workspace:*",
    "@yunbox/server": "workspace:*"
  }
}
